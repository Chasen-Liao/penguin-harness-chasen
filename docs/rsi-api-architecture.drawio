        <mxCell id="e_log_reader" value="历史会话" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;flowAnimation=1;labelBackgroundColor=default;defaultLabelBackgroundColor=page;fontColor=#1D4ED8;fontSize=11;" edge="1" parent="1" source="ext_log" target="adp_reader">
          <mxGeometry relative="1" as="geometry"/>
