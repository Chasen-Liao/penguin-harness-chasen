        <mxCell id="e_reader_push" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;flowAnimation=1;" edge="1" parent="adapter" source="adp_reader" target="adp_push">
          <mxGeometry relative="1" as="geometry"/>
