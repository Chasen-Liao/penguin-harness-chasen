        <mxCell id="e_iter" value="同一基准迭代" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;flowAnimation=1;labelBackgroundColor=default;defaultLabelBackgroundColor=page;fontColor=#5B21B6;fontSize=11;" edge="1" parent="platform" source="ph_bench" target="ph_opt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_proof" value="v1 + 指标" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;flowAnimation=1;labelBackgroundColor=default;defaultLabelBackgroundColor=page;fontColor=#5B21B6;fontSize=11;" edge="1" parent="platform" source="ph_opt" target="ph_gate">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
