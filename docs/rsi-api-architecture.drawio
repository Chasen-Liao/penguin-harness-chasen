        <mxCell id="e_reader_api" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;flowAnimation=1;" edge="1" parent="adapter" source="adp_reader" target="adp_api_read">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_push_l3" value="③ 推送" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;flowAnimation=1;labelBackgroundColor=default;defaultLabelBackgroundColor=page;fontColor=#1D4ED8;fontSize=11;" edge="1" parent="1" source="adp_push" target="ph_push">
          <mxGeometry relative="1" as="geometry"/>
